generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum task_runtime {
  browser
  node
  sql
}

enum task_status {
  not_started
  in_progress
  completed
}

enum flag_event_type {
  FULLSCREEN_EXIT
  TAB_SWITCH
  PASTE_BLOCKED
  WINDOW_BLUR
}

enum review_priority {
  LOW
  NORMAL
  HIGH
}

model trainee {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  email String @unique

  task_progress     task_progress[]
  day_completions   day_completion[]
  journal_responses journal_response[]
  typing_results    typing_test_result[]
  flag_events       flag_event[]
  activity_logs     activity_log[]
}

// ---------- Curriculum (same for every trainee; loaded by the seed script) ----------

model course {
  id         String @id // "html", "css", "js", "ts", "node", "postgresql", "prisma", "react"
  title      String
  sort_order Int    @unique // curriculum order: html = 1 ... react = 8

  days curriculum_day[]
}

model curriculum_day {
  id             String @id // "css-day-03"
  course_id      String
  day_number     Int
  title          String
  subtitle       String // also the dashboard's short description
  lesson_summary String
  journal_prompt String

  course              course               @relation(fields: [course_id], references: [id])
  learning_objectives learning_objective[]
  self_check_items    self_check_item[]
  tasks               task[]
  completions         day_completion[]
  journal_responses   journal_response[]

  @@unique([course_id, day_number])
}

model learning_objective {
  id                String @id // "html-1-obj-1"
  curriculum_day_id String
  code              String // "1.1"
  title             String
  description       String
  sort_order        Int

  curriculum_day curriculum_day @relation(fields: [curriculum_day_id], references: [id], onDelete: Cascade)

  @@index([curriculum_day_id, sort_order])
}

model self_check_item {
  id                String  @id // "html-1-check-1"
  curriculum_day_id String
  code              String
  label             String
  description       String
  is_required       Boolean @default(true)
  sort_order        Int

  curriculum_day curriculum_day @relation(fields: [curriculum_day_id], references: [id], onDelete: Cascade)

  @@index([curriculum_day_id, sort_order])
}

model task {
  id                    String       @id // "css-day-03-t-2"
  curriculum_day_id     String
  sequence_order        Int
  title                 String
  instructions_markdown String
  is_stretch_goal       Boolean      @default(false)
  estimated_minutes     Int?
  runtime               task_runtime
  run_command           String? // node only, e.g. "npm test"
  setup_sql             String? // sql only
  starter_files         Json         @default("[]") // TaskFile[]: [{ "path": "index.html", "content": "..." }]

  curriculum_day curriculum_day  @relation(fields: [curriculum_day_id], references: [id], onDelete: Cascade)
  progress       task_progress[]
  flag_events    flag_event[]

  @@unique([curriculum_day_id, sequence_order])
}

// ---------- Trainee data ----------

model task_progress {
  id                 String      @id @default(uuid()) @db.Uuid
  trainee_id         String      @db.Uuid
  task_id            String
  status             task_status @default(in_progress)
  files              Json? // TaskFile[]; null = never saved, use task.starter_files
  code_updated_at    DateTime?   @db.Timestamptz
  first_submitted_at DateTime?   @db.Timestamptz
  last_submitted_at  DateTime?   @db.Timestamptz
  created_at         DateTime    @default(now()) @db.Timestamptz

  trainee trainee @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  task    task    @relation(fields: [task_id], references: [id])

  @@unique([trainee_id, task_id])
}

model day_completion {
  id                String   @id @default(uuid()) @db.Uuid
  trainee_id        String   @db.Uuid
  curriculum_day_id String
  completed_at      DateTime @default(now()) @db.Timestamptz

  trainee        trainee        @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  curriculum_day curriculum_day @relation(fields: [curriculum_day_id], references: [id])

  @@unique([trainee_id, curriculum_day_id])
}

model journal_response {
  id                String   @id @default(uuid()) @db.Uuid
  trainee_id        String   @db.Uuid
  curriculum_day_id String
  response_text     String
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  trainee        trainee        @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  curriculum_day curriculum_day @relation(fields: [curriculum_day_id], references: [id])

  @@unique([trainee_id, curriculum_day_id])
}

model typing_test_result {
  id         String   @id @default(uuid()) @db.Uuid
  trainee_id String   @db.Uuid
  wpm        Int
  accuracy   Float // 0-100, rounded to one decimal by the service
  taken_at   DateTime @default(now()) @db.Timestamptz

  trainee trainee @relation(fields: [trainee_id], references: [id], onDelete: Cascade)

  @@index([trainee_id, taken_at])
}

model flag_event {
  id              String          @id @default(uuid()) @db.Uuid
  trainee_id      String          @db.Uuid
  task_id         String
  type            flag_event_type
  review_priority review_priority @default(NORMAL)
  context_data    Json?
  duration_ms     Int?
  timestamp       DateTime        @default(now()) @db.Timestamptz

  trainee trainee @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  task    task    @relation(fields: [task_id], references: [id])

  @@index([trainee_id, task_id, timestamp])
}

model activity_log {
  id             String   @id @default(uuid()) @db.Uuid
  trainee_id     String   @db.Uuid
  date           DateTime @db.Date // calendar day in Asia/Kolkata
  active_seconds Int      @default(0)
  coding_seconds Int      @default(0)

  trainee trainee @relation(fields: [trainee_id], references: [id], onDelete: Cascade)

  @@unique([trainee_id, date])
}
